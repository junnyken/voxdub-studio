# ===== VoxDub SaaS Backend — .env.example =====
# Chép sang .env rồi điền giá trị thật. KHÔNG commit .env
#
# Backend tự serve luôn website (website/dist) trên CÙNG cổng, nên khi
# chuyển từ test local sang chạy thật CHỈ CẦN đổi PUBLIC_URL — không phải
# build lại frontend, không phải đụng CORS.

# === ĐỔI DUY NHẤT CHỖ NÀY khi lên domain thật ===
# Test local:  http://localhost:3001
# Chạy thật:   https://example.com  (domain trỏ về máy chủ này)
PUBLIC_URL=http://localhost:3001

# === Server ===
NODE_ENV=development
PORT=3001
# Test local để 127.0.0.1. Chạy thật sau nginx cũng để 127.0.0.1;
# chỉ đặt 0.0.0.0 nếu cho truy cập thẳng không qua nginx.
HOST=127.0.0.1
# Đứng sau nginx thì đặt 1 để đọc đúng IP client từ X-Forwarded-For
TRUST_PROXY=0

# === MongoDB ===
# Local mặc định không cần user/pass. Chạy thật nên bật auth:
#   mongodb://voxdub:<password>@localhost:27017/voxdub
MONGODB_URI=mongodb://localhost:27017/voxdub

# === Bí mật (bắt buộc) — sinh bằng: openssl rand -hex 32 ===
JWT_SECRET=
ADMIN_TOKEN=
# Đúng 64 ký tự hex (32 byte) — mã hóa API key của AI provider trong DB
APP_ENCRYPTION_KEY=

# Thời hạn device token. App tự gia hạn khi còn dưới nửa hạn.
JWT_EXPIRES_IN=30d

# === Email (Brevo SMTP) — gửi key sau khi thanh toán ===
# Để trống = tắt gửi mail (key vẫn hiện trên web).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
MAIL_FROM=VoxDub Studio <noreply@example.com>

# === Thanh toán — PayOS (payos.vn) ===
# Lấy 3 key trong PayOS Dashboard > Kênh thanh toán.
# Webhook đăng ký bằng: npm run payos:confirm-webhook (server phải đang chạy,
# PUBLIC_URL phải là HTTPS công khai).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# === Nâng cao (thường không cần đụng) ===
# Chỗ chứa website đã build. Mặc định: ../website/dist
#WEB_DIST=
# Chỉ dùng khi website host TÁCH RỜI backend (khác domain) — khi đó mới cần
# CORS. Serve cùng nhau (mặc định) thì bỏ qua.
#CORS_ORIGIN=

# === AI Providers ===
# Quản lý qua trang Admin > Nơi gọi mô hình (lưu MongoDB, apiKey mã hóa).
# Hai biến dưới CHỈ dùng cho scripts/seed-config.js lần đầu.
SEED_OPENROUTER_API_KEY=
SEED_OPENROUTER_MODEL=google/gemini-2.5-flash

# === Cấu hình credit / feature flag ===
# Quản lý qua trang Admin > Cấu hình — không cần đặt ở đây.
# Defaults: credit.enabled=true, credit.vox.to.vnd=10, trial.vox=200

# === Cloud rendering (mini-spec V9 → V12 — /v1/jobs, /internal/jobs) ===
# V12: xử lý bất đồng bộ THẬT qua service `render_worker` riêng trong
# docker-compose.yml (Python + torch + demucs đóng gói sẵn trong image —
# KHÔNG cần cài gì ngoài Docker nữa, khác V9).
#
# BẮT BUỘC khi dùng docker compose: secret riêng cho worker gọi
# /internal/jobs/* — tách hẳn khỏi ADMIN_TOKEN và token thiết bị. Cả
# control_server VÀ render_worker đọc CÙNG biến này (render_worker dùng
# chung control_server/.env qua env_file trong docker-compose.yml).
WORKER_INTERNAL_TOKEN=

# Chỉ cần khi KHÔNG dùng docker compose (chạy render-job.service.js trực
# tiếp ngoài container) — trống = mặc định của render_worker.py (python3
# trong image + đường copy sẵn /app/autodub_media/demucs_worker.py).
#DEMUCS_PYTHON=
#DEMUCS_WORKER_SCRIPT=

# Mini-spec V37 (docs/PLAN.md) — nhạc nền/hiệu ứng âm thanh AI qua
# ElevenLabs (Sound Effects v2 + Music v2). Server quản lý key (người dùng
# KHÔNG tự cấp key) — thiếu biến này thì /v1/ai/sound-effect và /v1/ai/music
# trả 503 ELEVENLABS_NOT_CONFIGURED (degrade rõ ràng, không giả vờ chạy).
# Tính năng còn TẮT mặc định qua cloud.music_match.enabled (bật ở Admin).
ELEVENLABS_API_KEY=
# Thư mục lưu tạm file job — PHẢI khớp giữa control_server và render_worker
# (docker-compose.yml đã đặt sẵn /data/render-jobs qua volume dùng chung).
# Trống ngoài Docker = dùng thư mục temp hệ thống.
#RENDER_UPLOAD_DIR=
# Giá/bật-tắt qua Admin > Cấu hình: cloud.render.enabled,
# credit.cost.cloud.demucs (mặc định 50 Vox), cloud.render.ttl.hours,
# cloud.render.heartbeat.stale.minutes (mặc định 5 — worker mất kết nối
# quá lâu thì job tự chuyển "failed", không treo mãi ở "running").
